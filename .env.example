PORT=8080
APP_ENV=development
MONGO_URI=mongodb://localhost:27017/cdac_db
DB_URL=jdbc:postgresql://localhost:5432/cdac_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
CORS_ORIGINS=http://localhost:3000
# Schema is managed by Flyway; Hibernate only validates the mapping
JPA_DDL_AUTO=validate

# JWT (HS256). Must be identical in express-api, at least 32 chars.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_ISSUER=cdac-auth
JWT_AUDIENCE=cdac-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MediCare <no-reply@cdac.local>
APP_BASE_URL=http://localhost:3000

# First-boot admin (only created if no ADMIN account exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
